// Aviso TM — referat de necesitate approval workflow (demo).
// Money is stored as integer lei (valoareLei: Int) — never a float.
// Transition is an APPEND-ONLY audit trail: code only ever INSERTs.

generator client {
  provider = "prisma-client-js"
  // native = local dev; the linux targets are for the Docker image / Railway
  // (amd64 → debian-openssl-3.0.x, arm64 build hosts → linux-arm64-openssl-3.0.x).
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Neon this is the POOLED endpoint (host with `-pooler`).
  url      = env("DATABASE_URL")
  // Migrations / introspection must bypass the pooler. On Neon this is the
  // DIRECT endpoint (same URL without `-pooler`). Locally it equals DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ANGAJAT
  SEF_IERARHIC
  IT
  SSM
  ACHIZITII
  DIR_ECONOMIC
  DIR_GENERAL
}

enum ReferatStatus {
  IN_ASTEPTARE
  APROBAT
  RESPINS
  TRIMIS_INAPOI
  FINALIZAT
}

enum TaskStatus {
  PENDING
  WAITING
  APPROVED
  REJECTED
  SENT_BACK
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  referate           Referat[]      @relation("requester")
  approverTasks      ApprovalTask[] @relation("effectiveApprover")
  actedTasks         ApprovalTask[] @relation("actedBy")
  transitions        Transition[]   @relation("actor")
  attachments        Attachment[]   @relation("uploader")
}

model Referat {
  id          String        @id @default(cuid())
  articol     String
  cantitate   Int
  justificare String
  centruCost  String
  valoareLei  Int
  necesitaIt  Boolean       @default(false)
  necesitaSsm Boolean       @default(false)
  requesterId String
  workflowId  String?
  status      ReferatStatus @default(IN_ASTEPTARE)
  createdAt   DateTime      @default(now())

  requester   User           @relation("requester", fields: [requesterId], references: [id])
  workflow    Workflow?      @relation(fields: [workflowId], references: [id])
  tasks       ApprovalTask[]
  transitions Transition[]
  attachments Attachment[]
}

/// A file attached to a referat (offer, spec, photo …). The bytes live in
/// Cloudflare R2 under `storageKey`; this row is the metadata. Uploads are
/// allowed only while the referat is IN_ASTEPTARE or TRIMIS_INAPOI.
model Attachment {
  id           String   @id @default(cuid())
  referatId    String
  fileName     String
  storageKey   String   @unique
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  referat    Referat @relation(fields: [referatId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("uploader", fields: [uploadedById], references: [id])

  @@index([referatId])
}

/// A configurable approval chain. New referate materialize their tasks from the
/// steps of the single active workflow (isActive = true), evaluating each step's
/// appliesWhen condition against the referat. Editable from the admin screen.
model Workflow {
  id        String         @id @default(cuid())
  name      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  steps     WorkflowStep[]
  referate  Referat[]
}

/// One ordered step of a Workflow. `appliesWhen` is a JSON condition (null = the
/// step always applies); see api/src/config/condition.ts for the shape.
model WorkflowStep {
  id          String @id @default(cuid())
  workflowId  String
  order       Int
  role        Role
  label       String
  appliesWhen Json?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, order])
}

model ApprovalTask {
  id                  String     @id @default(cuid())
  referatId           String
  stepOrder           Int
  role                Role
  status              TaskStatus @default(PENDING)
  effectiveApproverId String?
  actedById           String?
  actedAt             DateTime?
  comment             String?

  referat           Referat @relation(fields: [referatId], references: [id], onDelete: Cascade)
  effectiveApprover User?   @relation("effectiveApprover", fields: [effectiveApproverId], references: [id])
  actedBy           User?   @relation("actedBy", fields: [actedById], references: [id])

  @@unique([referatId, stepOrder])
  @@index([role, status])
}

model Transition {
  id        String   @id @default(cuid())
  referatId String
  fromState String?
  toState   String
  actorId   String
  comment   String?
  createdAt DateTime @default(now())

  referat Referat @relation(fields: [referatId], references: [id], onDelete: Cascade)
  actor   User    @relation("actor", fields: [actorId], references: [id])

  @@index([referatId, createdAt])
}
