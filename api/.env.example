# PostgreSQL connection (matches docker-compose.yml at the repo root; host port 5434)
DATABASE_URL="postgresql://aviso:aviso@localhost:5434/aviso_tm?schema=public"

# HTTP port the API listens on
PORT=3000

# Allowed CORS origin for the Angular dev server
CORS_ORIGIN="http://localhost:4200"

# Routing threshold in whole lei — at or above this, the full 4-step chain applies
APPROVAL_THRESHOLD_LEI=5000
