# PostgreSQL connection (matches docker-compose.yml at the repo root; host port 5434)
DATABASE_URL="postgresql://aviso:aviso@localhost:5434/aviso_tm?schema=public"

# HTTP port the API listens on (the web app's environment.ts targets this port)
PORT=3001

# Allowed CORS origin for the Angular dev server
CORS_ORIGIN="http://localhost:4200"

# Routing threshold in whole lei — at or above this, the full 4-step chain applies
APPROVAL_THRESHOLD_LEI=5000

# Cloudflare R2 (S3-compatible) — attachment storage. Create an R2 bucket and an
# API token (Object Read & Write) in the Cloudflare dashboard, then fill these in.
# R2_ENDPOINT is the bucket's "S3 API" URL WITHOUT the bucket path (required for
# jurisdiction buckets, e.g. https://<account>.eu.r2.cloudflarestorage.com);
# alternatively set R2_ACCOUNT_ID and the standard endpoint is derived.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
